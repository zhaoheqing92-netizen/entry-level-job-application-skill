{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83"
      ]
    },
    "windows-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.14",
        "--from",
        "windows-mcp==0.8.8",
        "windows-mcp",
        "serve",
        "--transport",
        "stdio",
        "--tools",
        "Screenshot,Snapshot,Click,Type,Scroll,Move,Shortcut,WaitFor,ControlStatus"
      ],
      "env": {
        "ANONYMIZED_TELEMETRY": "false"
      }
    }
  }
}
