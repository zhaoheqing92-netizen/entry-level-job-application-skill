{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "windows-mcp": {
      "command": "uvx",
      "args": ["windows-mcp", "serve", "--tools", "Screenshot,Snapshot,Click,Type,Scroll,Move,Shortcut,WaitFor,ControlStatus"],
      "env": {"ANONYMIZED_TELEMETRY": "false"}
    }
  }
}
